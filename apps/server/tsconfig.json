{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    // "rootDir": "./src",
    "rootDirs": ["src", "../../packages/shared/src"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@ridery/shared": ["../../packages/shared/src/index.ts"]
    },
  },
  "include": ["src/**/*"]
}